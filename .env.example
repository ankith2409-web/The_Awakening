# Local development only. Copy to `.env` and fill in.
#
# `.env` is gitignored. Never commit a filled-in copy, and never paste a real
# connection string into this file: it is published with the repository.

# ---- Server-side (Vercel). Never exposed to the browser. --------------------
#
# Neon POOLED connection string: project -> Connection Details -> pooled.
# A predictable value here is a database credential.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Signs the QR payload. At least 16 characters and unique to this deployment.
# A predictable value lets anyone forge a pass. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TICKET_SECRET=

# Read only by `npm run db:setup`, which creates the admin row once. The
# plaintext password is never stored - only its bcrypt hash.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Client-side (Vite inlines these into the public JS bundle). ------------
# `false` points the client at the real API above. Leave unset (or `true`) for
# the offline in-memory mock, which needs no database.
#
# These CANNOT be marked sensitive: Vercel rejects secret visibility for
# variables with a public framework prefix, because they ship to every visitor.
VITE_USE_MOCK_API=false

# Same origin - the function is mounted at /api, so no CORS setup is required.
VITE_API_BASE_URL=/api